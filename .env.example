# Backend
BACKEND_PORT=4001
WORK_DIR=./workspace
LOG_LEVEL=info
AUTH_TOKEN=dev-secret-change-me
CORS_ORIGIN=http://localhost:4000

# Ollama
OLLAMA_BASE_URL=http://103.186.18.11:11434
OLLAMA_MODEL=koda
# Optional: HTTP Basic Auth for a password-protected Ollama server
OLLAMA_USERNAME=
OLLAMA_PASSWORD=

# Image Generation (AUTOMATIC1111 Stable Diffusion WebUI)
# Start A1111 with: python launch.py --api --xformers --medvram
SD_BASE_URL=http://localhost:7860
# SD_MODEL=realisticVisionV51.safetensors   # checkpoint name shown in A1111 UI
SD_WIDTH=512
SD_HEIGHT=512
SD_STEPS=20
SD_CFG_SCALE=7
SD_SAMPLER=DPM++ 2M Karras
SD_NEGATIVE_PROMPT=blurry, bad quality, watermark, text, deformed

# Frontend (Next.js server-side proxy reads these)
BACKEND_URL=http://localhost:4001
BACKEND_AUTH_TOKEN=dev-secret-change-me

# PostgreSQL (session storage + pgvector memory)
# When set, sessions are stored in PostgreSQL instead of JSON files
DATABASE_URL=postgresql://koda:koda_secret@localhost:5432/koda

# Langfuse (LLM observability — self-hosted at localhost:3001 via docker compose)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3001

# Redis (tool output caching — set automatically in Docker Compose)
REDIS_URL=redis://localhost:6379

# Web Search
# Priority: Brave API → SearxNG → DuckDuckGo HTML
# Brave: get a free key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# SearxNG: set automatically in Docker Compose (http://searxng:8080 inside containers)
# For local dev without Docker, run: docker run -p 8888:8080 searxng/searxng
SEARXNG_URL=http://localhost:8888

# Multi-user Auth (JWT)
# SECRET used to sign JWTs — change this in production!
JWT_SECRET=koda_jwt_secret_change_me_in_production
