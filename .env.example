OLLAMA_PASSWORD=

# Image Generation (AUTOMATIC1111 Stable Diffusion WebUI)
# Start A1111 with: python launch.py --api --xformers --medvram
SD_BASE_URL=http://localhost:7860
# SD_MODEL=realisticVisionV51.safetensors   # checkpoint name shown in A1111 UI
SD_WIDTH=512
SD_HEIGHT=512
SD_STEPS=20
SD_CFG_SCALE=7
SD_SAMPLER=DPM++ 2M Karras
SD_NEGATIVE_PROMPT=blurry, bad quality, watermark, text, deformed

# Frontend (Next.js server-side proxy reads these)
BACKEND_URL=http://localhost:4001
BACKEND_AUTH_TOKEN=dev-secret-change-me
